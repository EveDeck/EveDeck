<?xml version="1.0" encoding="utf-8"?>
<!--
    The daemon is a LAN service speaking ws:// with no TLS, which Android blocks by default since
    Android 9.

    Cleartext is permitted globally rather than per-subnet because Android's network security config
    matches domains and literal hosts only — it has no CIDR support, so there is no way to express
    "private address space" here. The daemon address is user-configured and the app talks to nothing
    else, so the practical exposure is the same.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
