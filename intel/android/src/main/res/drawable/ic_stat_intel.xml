<?xml version="1.0" encoding="utf-8"?>
<!--
  Notification small icon. Android draws these as a flat white silhouette on an arbitrary
  background, so this is the EveDeck mark reduced to the three shapes that still read at 24dp:
  the orbital ring, the cube core and the vertical star. Colour and gradients are ignored here,
  which is why the full mark cannot be used.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFFFF">

    <!-- Star, vertical through the whole glyph. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M12,1.5 L12.9,8.2 L12,10.5 L11.1,8.2 Z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M12,22.5 L12.9,15.8 L12,13.5 L11.1,15.8 Z" />

    <!-- Cube core. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M12,6.6 L16.4,9.3 L16.4,14.7 L12,17.4 L7.6,14.7 L7.6,9.3 Z" />

    <!-- Orbital ring, tilted the way the mark's ring sits. -->
    <group
        android:pivotX="12"
        android:pivotY="12"
        android:rotation="-18">
        <path
            android:fillColor="#00000000"
            android:pathData="M12,8.1 m-9,3.9 a9,3.9 0 1,0 18,0 a9,3.9 0 1,0 -18,0"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="1.5" />
    </group>
</vector>
