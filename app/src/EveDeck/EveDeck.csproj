<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <!-- Bumped from 18362.0: the WGC tile-capture path (WindowCaptureService) uses
         GraphicsCaptureSession.IsCursorCaptureEnabled, which needs 19041.0; matches the TFM's own
         Windows SDK target already, and virtually every Win10/11 install is well past this build. -->
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Needed for the row-copy in WindowCaptureService's WGC/Direct3D readback path. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>EveDeck</AssemblyName>
    <RootNamespace>EveDeck</RootNamespace>
    <Version>1.56.1</Version>
    <Copyright>Copyright © 2026 EveDeck</Copyright>
    <Authors>EveDeck</Authors>
    <Company>EveDeck</Company>
    <!-- Framework-dependent builds accept any installed .NET 10+ runtime instead of demanding an
         exact major match, so users don't hit the "install .NET" popup after a runtime upgrade. -->
    <RollForward>LatestMajor</RollForward>
    <!-- DPI awareness is declared in app.manifest (dpiAwareness/dpiAware) since this is a WPF-primary
         app (WinForms is used only for the tray icon and DWM overlay windows), and the WFO0003 analyzer
         assumes a WinForms-hosted app and doesn't apply here; the runtime SetProcessDpiAwarenessContext
         call in App.xaml.cs is a defensive fallback, not the primary mechanism. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
    <ApplicationIcon>Assets\evedeck.ico</ApplicationIcon>
    <!-- Custom Main (below, in App.xaml.cs). Added so Velopack could initialise before anything
         else at startup; Velopack is gone, but the explicit Main is kept because it requires
         App.xaml to stop being the implicit ApplicationDefinition (which auto-generates its own
         Main and would collide with ours). See EnableDefaultApplicationDefinition below. -->
    <StartupObject>EveDeck.App</StartupObject>
    <!-- Stop the SDK from auto-adding App.xaml as an ApplicationDefinition. The Remove/Page swap
         below handles the primary build, but the WPF markup "Pass 1" temp project (triggered whenever
         any XAML references a local clr-namespace, e.g. a converter) re-applied the default and
         generated a second Main -> CS0017 "more than one entry point". Disabling the default here
         keeps App.xaml a plain Page in every pass, so local-namespace converters build cleanly. -->
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.WinUI.Notifications" Version="7.1.2" />
    <!-- Opt-in WGC local preview capture (Services\Wgc). GPU capture was removed in v1.22.0 after
         it hard-locked the machine under heavy multi-client DX12 load. This path is gated behind a
         setting, shares one D3D11 device, checks free VRAM before starting, and falls every tile
         back to a DWM thumbnail on any failure. Direct2D is NOT referenced (no on-GPU compositing
         this time): capture, then CPU readback, then GDI, same as the screenshot fallback. -->
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\evedeck-logo.png" />
    <Resource Include="Assets\evedeck-mark.png" />
    <Resource Include="Assets\evedeck.ico" />
    <Content Include="Assets\bg.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Michroma, under the SIL Open Font License 1.1 (see Assets\Fonts\Michroma-OFL.txt), bundled
         so the default label font renders correctly without requiring a separate system-wide font
         install. The OFL permits bundling and redistribution, which the previously bundled font
         (personal/non-commercial use only, all rights reserved) did not. That made it incompatible
         with EveDeck's own GPL-3.0 terms, since the GPL grants recipients rights the font withheld. -->
    <Resource Include="Assets\Fonts\Michroma-Regular.ttf" />
    <Content Include="Assets\Fonts\Michroma-OFL.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
