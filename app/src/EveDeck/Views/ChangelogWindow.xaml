<Window x:Class="EveDeck.Views.ChangelogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EveDeck — What's New"
        Width="540" Height="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="{StaticResource BgBrush}">

  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="42" ResizeBorderThickness="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>

  <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="42"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- Custom title bar -->
      <Border Grid.Row="0" BorderThickness="0,0,0,1">
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#080B12" Offset="0"/>
            <GradientStop Color="#0A0F18" Offset="0.7"/>
            <GradientStop Color="#0C141F" Offset="1"/>
          </LinearGradientBrush>
        </Border.Background>
        <Border.BorderBrush>
          <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#2BC0E4" Offset="0"/>
            <GradientStop Color="#1B4658" Offset="0.5"/>
            <GradientStop Color="#1F2C3A" Offset="1"/>
          </LinearGradientBrush>
        </Border.BorderBrush>
        <DockPanel>
          <Button Style="{StaticResource CloseButton}"
                  Click="Close_Click"
                  DockPanel.Dock="Right"
                  WindowChrome.IsHitTestVisibleInChrome="True"
                  ToolTip="Close">
            <TextBlock Text="&#x2715;" FontSize="12"/>
          </Button>
          <StackPanel Orientation="Horizontal" Margin="14,0" VerticalAlignment="Center">
            <Image Source="/Assets/evedeck-mark.png" Width="22" Height="22"
                   Margin="0,0,8,0" VerticalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
            <TextBlock Text="What's New" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
            <TextBlock Text="  EveDeck"
                       Foreground="{StaticResource MutedBrush}"
                       Margin="4,0,0,0"
                       VerticalAlignment="Center"/>
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- Content -->
      <Grid Grid.Row="1" Margin="24,20,24,20">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,4">
          <TextBlock Text="{Binding HeaderText}" FontSize="18" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding SubText}" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Row="1" Height="1" Background="{StaticResource BorderBrush}" Margin="0,10,0,16"/>

        <Grid Grid.Row="2">
          <TextBlock Text="Loading..." Foreground="{StaticResource MutedBrush}"
                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>

          <StackPanel Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}">
              Couldn't load the changelog right now (no network, or GitHub is unreachable).
            </TextBlock>
            <TextBlock Margin="0,10,0,0">
              <Hyperlink NavigateUri="https://github.com/EveDeck/EveDeck/releases" RequestNavigate="Hyperlink_RequestNavigate">
                View releases on GitHub &#8594;
              </Hyperlink>
            </TextBlock>
          </StackPanel>

          <ScrollViewer MaxHeight="340" VerticalScrollBarVisibility="Auto"
                        Visibility="{Binding ShowReleases, Converter={StaticResource BoolToVis}}">
            <ItemsControl ItemsSource="{Binding Releases}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <!-- The whole tile is the button, so the click target matches what looks clickable.
                       A Button (rather than a Border with a mouse handler) keeps it keyboard- and
                       screen-reader-reachable, which Store certification checks. -->
                  <Button Command="{Binding ToggleCommand}"
                          HorizontalContentAlignment="Stretch"
                          Cursor="Hand"
                          Focusable="{Binding CanExpand}">
                    <Button.Template>
                      <ControlTemplate TargetType="Button">
                        <Border x:Name="Tile"
                                Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,10">
                          <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Tile" Property="Background" Value="{StaticResource PanelAltBrush}"/>
                          </Trigger>
                          <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Tile" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Button.Template>
                    <StackPanel>
                      <TextBlock FontWeight="SemiBold" FontSize="13">
                        <Run Text="v"/><Run Text="{Binding Version, Mode=OneWay}"/>
                      </TextBlock>
                      <TextBlock Text="{Binding BodyText}" TextWrapping="Wrap" Margin="0,6,0,8"
                                 Foreground="{StaticResource TextBrush}" FontSize="12" LineHeight="18"/>
                      <!-- Only where there is genuinely more to read. -->
                      <TextBlock Text="{Binding ToggleText}"
                                 Foreground="{StaticResource AccentBrush}" FontSize="12"
                                 Visibility="{Binding CanExpand, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>

        <!-- Footer -->
        <Grid Grid.Row="3" Margin="0,16,0,0">
          <Button Content="View all releases" HorizontalAlignment="Left" Click="ViewAll_Click" MinWidth="130"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{Binding UpdateButtonText}" Click="Update_Click" MinWidth="130" Margin="0,0,8,0"
                    Style="{StaticResource AccentButton}"
                    Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVis}}"/>
            <Button Content="Got it" Click="Close_Click" MinWidth="90"
                    Style="{StaticResource AccentButton}"/>
          </StackPanel>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>
