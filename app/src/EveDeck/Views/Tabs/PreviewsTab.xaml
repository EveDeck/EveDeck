<UserControl x:Class="EveDeck.Views.Tabs.PreviewsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="16">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,12">
              <TextBlock Text="Previews" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,2"/>
              <TextBlock Text="Live thumbnails of background clients in the screen corners while the master fills center. Switching is instant, with no window moves - just overlay visibility changes."
                         Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap"/>
            </StackPanel>

            <Grid Grid.Row="1">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>

              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                  <TextBox x:Name="PreviewsSearchBox" Padding="7,5" FontSize="12"
                           TextChanged="PreviewsSearchBox_TextChanged"
                           GotFocus="PreviewsSearchBox_GotFocus"/>
                  <TextBlock Text="Search preview settings..." IsHitTestVisible="False"
                             Foreground="{StaticResource MutedBrush}" FontSize="12"
                             Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Text, ElementName=PreviewsSearchBox}" Value="">
                            <Setter Property="Visibility" Value="Visible"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </Grid>

                <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="6">
                  <Grid>
                    <ListBox x:Name="PreviewsMenu" SelectedIndex="0" BorderThickness="0" Background="Transparent">
                      <ListBoxItem Content="Active frame"/>
                      <ListBoxItem Content="Label &#8212; normal"/>
                      <ListBoxItem Content="Label &#8212; MASTER"/>
                      <ListBoxItem Content="Tiles"/>
                      <ListBoxItem Content="Non-EVE apps"/>
                      <ListBoxItem Content="Inactive client border"/>
                    </ListBox>
                    <TextBlock x:Name="PreviewsNoMatchText" Text="No settings match" Visibility="Collapsed"
                               Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap"
                               Margin="6,10,6,0" HorizontalAlignment="Center"/>
                  </Grid>
                </Border>
              </Grid>

              <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
                <Grid x:Name="PreviewsSectionsHost" MaxWidth="700" HorizontalAlignment="Left">
                  <!-- section 0: Active frame -->
                  <StackPanel Visibility="{Binding SelectedIndex, ElementName=PreviewsMenu, Converter={StaticResource IndexToVisibility}, ConverterParameter=0}">
                    <TextBlock Text="Active frame" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <TextBlock TextWrapping="Wrap" LineHeight="20" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,14">
                      The highlight drawn around whichever client currently has focus.
                    </TextBlock>
              <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                      BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,14">
                <StackPanel>
                  <CheckBox Content="Enable active client frame"
                            IsChecked="{Binding ActiveFrameEnabled}"
                            ToolTip="Draws a click-through outline around whichever EVE client you're currently using."
                            Margin="0,0,0,10"/>
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
                    <TextBlock Text="Style" VerticalAlignment="Center" Width="80" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                    <ComboBox Width="150" SelectedValuePath="Tag" FontSize="12"
                              SelectedValue="{Binding ActiveFrameStyle}">
                      <ComboBoxItem Tag="Snapshot" Content="Snapshot (glow corners)"/>
                      <ComboBoxItem Tag="SnapshotFrame" Content="Snapshot + Full Frame"/>
                      <ComboBoxItem Tag="Solid" Content="Solid"/>
                      <ComboBoxItem Tag="Dashed" Content="Dashed"/>
                      <ComboBoxItem Tag="Dotted" Content="Dotted"/>
                      <ComboBoxItem Tag="Neon" Content="Neon (pulsing glow)"/>
                      <ComboBoxItem Tag="BreathingGlow" Content="Breathing glow"/>
                      <ComboBoxItem Tag="Shimmer" Content="Shimmer"/>
                      <ComboBoxItem Tag="Rainbow" Content="Rainbow"/>
                      <ComboBoxItem Tag="ElectricArc" Content="Electric arc"/>
                      <ComboBoxItem Tag="Zigzag" Content="Zigzag"/>
                    </ComboBox>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
                    <TextBlock Text="Thickness" VerticalAlignment="Center" Width="80" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                    <Slider Minimum="1" Maximum="20" Value="{Binding ActiveFrameThickness}" Width="150" VerticalAlignment="Center"
                            IsSnapToTickEnabled="True" TickFrequency="1"/>
                    <TextBlock Text="{Binding ActiveFrameThickness, StringFormat={}{0}px}" VerticalAlignment="Center" Margin="8,0,0,0" FontSize="12"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
                    <TextBlock Text="Glow radius" VerticalAlignment="Center" Width="80" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                    <Slider Minimum="1" Maximum="40" Value="{Binding ActiveFrameGlowRadius}" Width="150" VerticalAlignment="Center"
                            IsSnapToTickEnabled="True" TickFrequency="1" IsEnabled="{Binding ActiveFrameGlowEnabled}"/>
                    <TextBlock Text="{Binding ActiveFrameGlowRadius, StringFormat={}{0}px}" VerticalAlignment="Center" Margin="8,0,8,0" FontSize="12"/>
                    <CheckBox Content="Enabled" IsChecked="{Binding ActiveFrameGlowEnabled}"
                              ToolTip="Turn off to keep the Snapshot corners crisp instead of blurred into a glow. No effect on Solid/Dashed/Dotted, which never glow."
                              VerticalAlignment="Center" FontSize="12"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Color" VerticalAlignment="Center" Width="80" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                    <Border Width="24" Height="24" Margin="0,0,8,0" CornerRadius="4"
                            Background="{Binding ActiveFrameBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                    <Button Content="Pick Color..." Click="FrameColorPick_Click" Padding="6,3" Margin="0,0,8,0" FontSize="12"/>
                    <Button Content="Amber" Tag="#F59E0B" Click="FrameColorPreset_Click" Padding="6,3" FontSize="12" Margin="0,0,4,0"/>
                    <Button Content="Cyan"  Tag="#22D3EE" Click="FrameColorPreset_Click" Padding="6,3" FontSize="12" Margin="0,0,4,0"/>
                    <Button Content="Green" Tag="#22C55E" Click="FrameColorPreset_Click" Padding="6,3" FontSize="12" Margin="0,0,4,0"/>
                    <Button Content="Red"   Tag="#EF4444" Click="FrameColorPreset_Click" Padding="6,3" FontSize="12" Margin="0,0,4,0"/>
                    <Button Content="White" Tag="#FFFFFF"  Click="FrameColorPreset_Click" Padding="6,3" FontSize="12" Margin="0,0,4,0"/>
                    <Button Content="Blue"  Tag="#3B82F6" Click="FrameColorPreset_Click" Padding="6,3" FontSize="12"/>
                  </StackPanel>
                </StackPanel>
              </Border>
                  </StackPanel>
                  <!-- section 1: Preview label - normal -->
                  <StackPanel Visibility="{Binding SelectedIndex, ElementName=PreviewsMenu, Converter={StaticResource IndexToVisibility}, ConverterParameter=1}">
                    <TextBlock Text="Preview label &#8212; normal" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <TextBlock TextWrapping="Wrap" LineHeight="20" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,14">
                      How the name label is drawn on every preview that is not the master.
                    </TextBlock>
              <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                      BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                <StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
                    <TextBlock Text="Style" VerticalAlignment="Center" Width="80" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                    <ComboBox Width="170" SelectedValuePath="Tag" FontSize="12"
                              SelectedValue="{Binding CornerOverlayLabelStyle}"
                              ToolTip="Pill = a name chip over the tile. Icon+name = character portrait beside plain text.">
                      <ComboBoxItem Tag="Pill" Content="Pill (name chip)"/>
                      <ComboBoxItem Tag="IconText" Content="Character icon + name"/>
                    </ComboBox>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
                    <TextBlock Text="Font" VerticalAlignment="Center" Width="80" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                    <Button Content="Choose font..." Click="LabelFontPick_Click" Padding="6,3" Margin="0,0,8,0" FontSize="12"/>
                    <Button Content="Default font" Click="LabelFontDefault_Click" Padding="6,3" Margin="0,0,8,0" FontSize="12"
                            ToolTip="Switch back to Michroma, the font EveDeck ships with. Keeps your size and color. Michroma is built into EveDeck, so it won't appear in the Choose font list unless you install it yourself."/>
                    <TextBlock Text="{Binding LabelFontSummary}" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
                    <TextBlock Text="Style" VerticalAlignment="Center" Width="80" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                    <CheckBox Content="Bold" IsChecked="{Binding LabelBold}" Margin="0,0,16,0" FontSize="12"/>
                    <CheckBox Content="Italic" IsChecked="{Binding LabelItalic}" Margin="0,0,16,0" FontSize="12"/>
                    <CheckBox Content="Drop shadow" IsChecked="{Binding LabelDropShadow}" Margin="0,0,16,0" FontSize="12"/>
                    <CheckBox Content="Outline" IsChecked="{Binding LabelOutline}" FontSize="12"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,16" VerticalAlignment="Center">
                    <TextBlock Text="Text opacity" VerticalAlignment="Center" Width="80" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                    <Slider Minimum="20" Maximum="100" Value="{Binding LabelOpacity}" Width="150" VerticalAlignment="Center"
                            IsSnapToTickEnabled="True" TickFrequency="5"/>
                    <TextBlock Text="{Binding LabelOpacity, StringFormat={}{0}%}" VerticalAlignment="Center" Margin="8,0,0,0" FontSize="12"/>
                  </StackPanel>

                  <StackPanel Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
                    <TextBlock Text="Background" VerticalAlignment="Center" Width="80" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                    <ComboBox Width="110" SelectedValuePath="Tag" FontSize="12" Margin="0,0,8,0"
                              SelectedValue="{Binding LabelBackgroundStyle}"
                              ToolTip="The label's own backdrop — applies to both label styles above (Pill's name chip and Icon+name's portrait row alike), independent of the label opacity above.">
                      <ComboBoxItem Tag="Solid" Content="Solid"/>
                      <ComboBoxItem Tag="Gradient" Content="Gradient"/>
                      <ComboBoxItem Tag="None" Content="None (text only)"/>
                    </ComboBox>
                    <Border Width="24" Height="24" Margin="0,0,6,0" CornerRadius="4"
                            Background="{Binding LabelBackgroundBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                    <Button Content="Pick Color..." Click="LabelBackgroundColorPick_Click" Padding="6,3" FontSize="12"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="80,0,0,16" VerticalAlignment="Center">
                    <StackPanel.Style>
                      <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding LabelBackgroundStyle}" Value="Gradient">
                            <Setter Property="Visibility" Value="Visible"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </StackPanel.Style>
                    <TextBlock Text="Gradient to" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,8,0"/>
                    <Border Width="24" Height="24" Margin="0,0,6,0" CornerRadius="4"
                            Background="{Binding LabelBackgroundBrush2}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                    <Button Content="Pick Color..." Click="LabelBackgroundColor2Pick_Click" Padding="6,3" FontSize="12" Margin="0,0,8,0"/>
                    <TextBlock Text="Top-to-bottom blend" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,16" VerticalAlignment="Center">
                    <StackPanel.Style>
                      <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding LabelBackgroundStyle}" Value="None">
                            <Setter Property="Visibility" Value="Collapsed"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </StackPanel.Style>
                    <TextBlock Text="Chip opacity" VerticalAlignment="Center" Width="80" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                    <Slider Minimum="0" Maximum="100" Value="{Binding LabelBackgroundOpacity}" Width="150" VerticalAlignment="Center"
                            IsSnapToTickEnabled="True" TickFrequency="5"
                            ToolTip="Transparency of the chip backdrop only — separate from the whole-label Text opacity above, which fades text too."/>
                    <TextBlock Text="{Binding LabelBackgroundOpacity, StringFormat={}{0}%}" VerticalAlignment="Center" Margin="8,0,0,0" FontSize="12"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,16" VerticalAlignment="Center">
                    <StackPanel.Style>
                      <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding LabelBackgroundStyle}" Value="None">
                            <Setter Property="Visibility" Value="Collapsed"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </StackPanel.Style>
                    <TextBlock Text="Texture" VerticalAlignment="Center" Width="80" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                    <ComboBox Width="110" SelectedValuePath="Tag" FontSize="12"
                              SelectedValue="{Binding LabelBackgroundTexture}"
                              ToolTip="A subtle vector pattern drawn over the chip fill above.">
                      <ComboBoxItem Tag="None" Content="None"/>
                      <ComboBoxItem Tag="Diagonal" Content="Diagonal hatch"/>
                      <ComboBoxItem Tag="Dots" Content="Dot grid"/>
                      <ComboBoxItem Tag="Noise" Content="Noise / grain"/>
                    </ComboBox>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
                    <TextBlock Text="Roundness" VerticalAlignment="Center" Width="80" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                    <Slider Minimum="0" Maximum="20" Value="{Binding LabelCornerRadius}" Width="150" VerticalAlignment="Center"
                            IsSnapToTickEnabled="True" TickFrequency="1"
                            ToolTip="Corner radius of the chip backdrop, in pixels."/>
                    <TextBlock Text="{Binding LabelCornerRadius, StringFormat={}{0}px}" VerticalAlignment="Center" Margin="8,0,0,0" FontSize="12"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Text inset" VerticalAlignment="Center" Width="80" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                    <TextBlock Text="H" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,4,0"/>
                    <Slider Minimum="0" Maximum="30" Value="{Binding LabelPaddingH}" Width="90" VerticalAlignment="Center"
                            IsSnapToTickEnabled="True" TickFrequency="1"
                            ToolTip="Horizontal padding between the chip edge and the text/portrait inside it, in pixels."/>
                    <TextBlock Text="{Binding LabelPaddingH, StringFormat={}{0}px}" VerticalAlignment="Center" Margin="4,0,10,0" FontSize="12"/>
                    <TextBlock Text="V" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,4,0"/>
                    <Slider Minimum="0" Maximum="20" Value="{Binding LabelPaddingV}" Width="90" VerticalAlignment="Center"
                            IsSnapToTickEnabled="True" TickFrequency="1"
                            ToolTip="Vertical padding between the chip edge and the text/portrait inside it, in pixels."/>
                    <TextBlock Text="{Binding LabelPaddingV, StringFormat={}{0}px}" VerticalAlignment="Center" Margin="4,0,0,0" FontSize="12"/>
                  </StackPanel>
                </StackPanel>
              </Border>
                  </StackPanel>
                  <!-- section 2: Preview label - MASTER -->
                  <StackPanel Visibility="{Binding SelectedIndex, ElementName=PreviewsMenu, Converter={StaticResource IndexToVisibility}, ConverterParameter=2}">
                    <TextBlock Text="Preview label &#8212; MASTER" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <TextBlock TextWrapping="Wrap" LineHeight="20" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,14">
                      Overrides for the master seat's label. Anything left unset here inherits from the normal label above.
                    </TextBlock>
              <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                      BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                <StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Button Content="&#8635; Reset to normal" Click="MasterLabelStyleAndFontReset_Click" Padding="5,1" Margin="10,0,0,0" MinHeight="0" FontSize="11"
                            ToolTip="Reset the MASTER font, style and opacity overrides so they inherit the normal label settings above"/>
                  </StackPanel>
                  <TextBlock Text="Falls back to the normal label settings above until you customize it here." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,8"/>
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
                    <TextBlock Text="Font" VerticalAlignment="Center" Width="80" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                    <Button Content="Choose font..." Click="MasterLabelFontPick_Click" Padding="6,3" Margin="0,0,8,0" FontSize="12"/>
                    <TextBlock Text="{Binding MasterLabelFontSummary}" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
                    <TextBlock Text="Style" VerticalAlignment="Center" Width="80" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                    <CheckBox Content="Bold" IsChecked="{Binding MasterLabelBold}" Margin="0,0,16,0" FontSize="12"/>
                    <CheckBox Content="Italic" IsChecked="{Binding MasterLabelItalic}" Margin="0,0,16,0" FontSize="12"/>
                    <CheckBox Content="Drop shadow" IsChecked="{Binding MasterLabelDropShadow}" Margin="0,0,16,0" FontSize="12"/>
                    <CheckBox Content="Outline" IsChecked="{Binding MasterLabelOutline}" FontSize="12"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,10" VerticalAlignment="Center">
                    <TextBlock Text="Opacity" VerticalAlignment="Center" Width="80" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                    <Slider Minimum="20" Maximum="100" Value="{Binding MasterLabelOpacity}" Width="150" VerticalAlignment="Center"
                            IsSnapToTickEnabled="True" TickFrequency="5"/>
                    <TextBlock Text="{Binding MasterLabelOpacity, StringFormat={}{0}%}" VerticalAlignment="Center" Margin="8,0,0,0" FontSize="12"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
                    <TextBlock Text="Background" VerticalAlignment="Center" Width="80" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                    <ComboBox Width="110" SelectedValuePath="Tag" FontSize="12" Margin="0,0,8,0"
                              SelectedValue="{Binding MasterLabelBackgroundStyle}"
                              ToolTip="Falls back to the normal chip backdrop above until you customize it here.">
                      <ComboBoxItem Tag="Solid" Content="Solid"/>
                      <ComboBoxItem Tag="Gradient" Content="Gradient"/>
                      <ComboBoxItem Tag="None" Content="None (text only)"/>
                    </ComboBox>
                    <Border Width="24" Height="24" Margin="0,0,6,0" CornerRadius="4"
                            Background="{Binding MasterLabelBackgroundBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                    <Button Content="Pick Color..." Click="MasterLabelBackgroundColorPick_Click" Padding="6,3" FontSize="12"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="80,0,0,10" VerticalAlignment="Center">
                    <StackPanel.Style>
                      <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding MasterLabelBackgroundStyle}" Value="Gradient">
                            <Setter Property="Visibility" Value="Visible"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </StackPanel.Style>
                    <TextBlock Text="Gradient to" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,8,0"/>
                    <Border Width="24" Height="24" Margin="0,0,6,0" CornerRadius="4"
                            Background="{Binding MasterLabelBackgroundBrush2}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                    <Button Content="Pick Color..." Click="MasterLabelBackgroundColor2Pick_Click" Padding="6,3" FontSize="12" Margin="0,0,8,0"/>
                    <TextBlock Text="Top-to-bottom blend" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,10" VerticalAlignment="Center">
                    <StackPanel.Style>
                      <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding MasterLabelBackgroundStyle}" Value="None">
                            <Setter Property="Visibility" Value="Collapsed"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </StackPanel.Style>
                    <TextBlock Text="Chip opacity" VerticalAlignment="Center" Width="80" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                    <Slider Minimum="0" Maximum="100" Value="{Binding MasterLabelBackgroundOpacity}" Width="150" VerticalAlignment="Center"
                            IsSnapToTickEnabled="True" TickFrequency="5"/>
                    <TextBlock Text="{Binding MasterLabelBackgroundOpacity, StringFormat={}{0}%}" VerticalAlignment="Center" Margin="8,0,0,0" FontSize="12"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,0" VerticalAlignment="Center">
                    <StackPanel.Style>
                      <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding MasterLabelBackgroundStyle}" Value="None">
                            <Setter Property="Visibility" Value="Collapsed"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </StackPanel.Style>
                    <TextBlock Text="Texture" VerticalAlignment="Center" Width="80" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                    <ComboBox Width="110" SelectedValuePath="Tag" FontSize="12"
                              SelectedValue="{Binding MasterLabelBackgroundTexture}">
                      <ComboBoxItem Tag="None" Content="None"/>
                      <ComboBoxItem Tag="Diagonal" Content="Diagonal hatch"/>
                      <ComboBoxItem Tag="Dots" Content="Dot grid"/>
                      <ComboBoxItem Tag="Noise" Content="Noise / grain"/>
                    </ComboBox>
                  </StackPanel>
                </StackPanel>
              </Border>
                  </StackPanel>
                  <!-- section 3: Preview tiles -->
                  <StackPanel Visibility="{Binding SelectedIndex, ElementName=PreviewsMenu, Converter={StaticResource IndexToVisibility}, ConverterParameter=3}">
                    <TextBlock Text="Preview tiles" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <TextBlock TextWrapping="Wrap" LineHeight="20" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,14">
                      The preview tiles themselves: opacity, live redraw, hover zoom, click behavior, info badges and jump badges.
                    </TextBlock>
              <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                      BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                <StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,16" VerticalAlignment="Center">
                    <TextBlock Text="Opacity" VerticalAlignment="Center" Width="80" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                    <Slider Minimum="10" Maximum="100" Value="{Binding PreviewOpacity}" Width="150" VerticalAlignment="Center"
                            IsSnapToTickEnabled="True" TickFrequency="5"
                            ToolTip="Transparency of every DWM preview thumbnail, corners and the master rect alike."/>
                    <TextBlock Text="{Binding PreviewOpacity, StringFormat={}{0}%}" VerticalAlignment="Center" Margin="8,0,0,0" FontSize="12"/>
                  </StackPanel>

                  <CheckBox Content="Enable live previews"
                            IsChecked="{Binding CornerOverlaysEnabled}"
                            Margin="0,0,0,2"/>
                  <!-- The default (on) is what gives EveDeck its EVE-O Preview style behaviour, and it
                       applies to EVERY multi-position layout, not just the master-slot families. Users
                       assumed a plain Grid tiled nine real windows, so spell out both sides here. -->
                  <TextBlock TextWrapping="Wrap" LineHeight="18" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="20,0,0,10">
On (the default) any layout whose slots sit at two or more distinct positions runs in preview mode: your master client renders live at full size and every other client parks off-screen and appears as a live thumbnail. That includes the plain Grid layouts, not just Center Master and the other master-slot families. Off, EveDeck instead resizes every client to its own slot and leaves them all on screen — which needs slots big enough for EVE to actually accept (about 1024x768 each). The Layouts tab shows which mode the selected profile will use.
                  </TextBlock>
                  <CheckBox Content="Click a preview to bring that client to the center"
                            IsChecked="{Binding FocusPreviewOnClick}"
                            Margin="0,0,0,2"/>
                  <TextBlock TextWrapping="Wrap" LineHeight="18" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,10">
Preview tiles shrink the whole client window. To read them better: raise UI Scaling in EVE (Esc > Display &amp; Graphics), enlarge the tile, or raise the hover zoom below. EveDeck will not crop to just the HUD — that would violate the EULA.
                  </TextBlock>
                  <TextBlock Text="Clicking a preview switches focus to that client (same as a hotkey). The click is never sent into EVE."
                             TextWrapping="Wrap" FontSize="12" Margin="20,0,0,10"
                             Foreground="{StaticResource MutedBrush}"/>
                  <CheckBox Content="Hover a preview to peek at that client over the master"
                            IsChecked="{Binding HoverPreviewEnabled}"
                            Margin="0,0,0,2"/>
                  <TextBlock Text="Hover over a preview to peek at that client. It returns to its corner when you move away."
                             TextWrapping="Wrap" FontSize="12" Margin="20,0,0,6"
                             Foreground="{StaticResource MutedBrush}"/>
                  <StackPanel Orientation="Horizontal" Margin="20,0,0,4" VerticalAlignment="Center"
                              IsEnabled="{Binding HoverPreviewEnabled}">
                    <TextBlock Text="Hover style" VerticalAlignment="Center" Width="80" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                    <ComboBox Width="220" SelectedValuePath="Tag" FontSize="12"
                              SelectedValue="{Binding HoverPreviewStyle}">
                      <ComboBoxItem Tag="Peek" Content="Peek (raise the real client over the master)"/>
                      <ComboBoxItem Tag="Zoom" Content="Zoom (magnify just the preview in place)"/>
                    </ComboBox>
                    <TextBlock Text="Zoom" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="10,0,4,0"/>
                    <TextBox Width="36"
                             Text="{Binding HoverZoomFactor, UpdateSourceTrigger=PropertyChanged}"
                             HorizontalContentAlignment="Center" FontSize="12"
                             ToolTip="Preview magnification for the Zoom style (1.5-8). Individual seats can override this on their slot card in the Clients tab."/>
                    <TextBlock Text="x" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="2,0,0,0"/>
                    <TextBlock Text="(1.5-8)" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="4,0,0,0"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="20,0,0,10" VerticalAlignment="Center"
                              IsEnabled="{Binding HoverPreviewEnabled}">
                    <TextBlock Text="Peek delay" VerticalAlignment="Center" Width="80" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                    <TextBox Width="48"
                             Text="{Binding HoverPreviewDelayMs, UpdateSourceTrigger=PropertyChanged}"
                             HorizontalContentAlignment="Center" FontSize="12"/>
                    <TextBlock Text="ms" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="4,0,0,0"/>
                    <TextBlock Text="(0 = instant, default 250)" VerticalAlignment="Center"
                               Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="6,0,0,0"/>
                  </StackPanel>
                  <CheckBox Content="Show an info button on each preview"
                            IsChecked="{Binding CornerOverlayInfoButtonEnabled}"
                            Margin="0,0,0,2"/>
                  <TextBlock Text="Adds a button to each preview showing live character status (wallet, ship, location, skills). Requires ESI scopes: re-link the character to grant them."
                             TextWrapping="Wrap" FontSize="12" Margin="20,0,0,6"
                             Foreground="{StaticResource MutedBrush}"/>
                  <WrapPanel Margin="20,0,0,10" IsEnabled="{Binding CornerOverlayInfoButtonEnabled}">
                    <TextBlock Text="Show:" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,8,0"/>
                    <CheckBox Content="Wallet" IsChecked="{Binding InfoFlyoutShowWallet}" Margin="0,0,14,0" ToolTip="Current ISK balance"/>
                    <CheckBox Content="Ship" IsChecked="{Binding InfoFlyoutShowShip}" Margin="0,0,14,0" ToolTip="Ship type currently flown"/>
                    <CheckBox Content="System" IsChecked="{Binding InfoFlyoutShowLocation}" Margin="0,0,14,0" ToolTip="Current solar system"/>
                    <CheckBox Content="System kills" IsChecked="{Binding InfoFlyoutShowDanger}" Margin="0,0,14,0" ToolTip="Recent kills reported in the current system, as a danger indicator"/>
                    <CheckBox Content="Training" IsChecked="{Binding InfoFlyoutShowSkill}" Margin="0,0,14,0" ToolTip="Skill currently in training and time remaining"/>
                    <CheckBox Content="SP" IsChecked="{Binding InfoFlyoutShowSp}" Margin="0,0,14,0" ToolTip="Total skill points"/>
                    <CheckBox Content="Jump fatigue" IsChecked="{Binding InfoFlyoutShowFatigue}" ToolTip="Current jump fatigue / reactivation timer"/>
                  </WrapPanel>
                  <CheckBox Content="Show jump fatigue / reactivation timers on the character label"
                            IsChecked="{Binding CornerOverlayShowJumpBadges}"
                            Margin="0,0,0,2"/>
                  <TextBlock Text="Adds a live jump fatigue / reactivation countdown line under the name on each preview's character label. Needs the character label switched on, and the same ESI scopes as the info button above."
                             TextWrapping="Wrap" FontSize="12" Margin="20,0,0,6"
                             Foreground="{StaticResource MutedBrush}"/>
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,2" VerticalAlignment="Center">
                    <TextBlock Text="Badge/popup text scale" VerticalAlignment="Center" Width="140"/>
                    <TextBox Width="48"
                             Text="{Binding CornerOverlayChromeScale, UpdateSourceTrigger=PropertyChanged}"
                             HorizontalContentAlignment="Center" FontSize="12"/>
                    <TextBlock Text="x" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="4,0,0,0"/>
                    <TextBlock Text="(1.0-4.0, default 1.0)" VerticalAlignment="Center"
                               Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="6,0,0,0"/>
                  </StackPanel>
                  <TextBlock Text="Grows the info badge, jump badges, and their popup text on-screen — independent of Windows' own display scaling, so a small/high-DPI monitor (e.g. a tablet used as a display) can stay legible without scaling the whole desktop up."
                             TextWrapping="Wrap" FontSize="12" Margin="0,0,0,10"
                             Foreground="{StaticResource MutedBrush}"/>
                  <CheckBox Content="Stream-safe mode (hide names, systems, and ISK on the overlay)"
                            IsChecked="{Binding StreamSafeMode}"
                            Margin="0,4,0,2"/>
                  <TextBlock Text="For streaming: hides character names, systems, and ISK on the overlay only. Bind 'Toggle stream-safe overlay' in Hotkeys to toggle mid-stream."
                             TextWrapping="Wrap" FontSize="12" Margin="20,0,0,10"
                             Foreground="{StaticResource MutedBrush}"/>
                  <CheckBox Content="Show character name pills"
                            IsChecked="{Binding CornerOverlayShowLabel}"
                            Margin="0,0,0,6"/>
                  <CheckBox Content="Prefix pills with position code (e.g. Top-Left - Name)"
                            IsChecked="{Binding CornerOverlayShowSlotNumber}"
                            Margin="0,0,0,6"/>
                  <CheckBox Content="Show current solar system on pills (from Local chat logs)"
                            IsChecked="{Binding CornerOverlayShowSystem}"
                            Margin="0,0,0,6"/>
                  <CheckBox Content="Hide a preview tile while that client is the active window"
                            IsChecked="{Binding HideActiveSeatTile}"
                            ToolTip="The active client is already on screen full-size; hiding its own tile reduces clutter"
                            Margin="0,0,0,6"/>
                  <TextBlock Text="To hide a single seat's preview permanently, use its 'Hide preview' checkbox on the Clients tab."
                             Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"/>

                  <CheckBox Content="Briefly hide all previews while a client is loading or under heavy GPU load"
                            IsChecked="{Binding SuspendPreviewsUnderGpuLoad}"
                            ToolTip="The character creator, boarding a capital, or a loading screen can spike the GPU. Previews drop for a few seconds, then return on their own. Also backs off after a graphics-driver reset."
                            Margin="0,0,0,6"/>

                  <CheckBox Content="Use GPU capture (WGC) for preview tiles instead of DWM thumbnails"
                            IsChecked="{Binding UseWgcPreviewCapture}"
                            ToolTip="Sharper tiles at small sizes, at more GPU cost than DWM. GPU capture cannot see a window Windows is not compositing, so with this on, inactive seats stack behind the master client instead of parking off-screen. Any tile that fails falls back to a DWM thumbnail on its own."
                            Margin="0,0,0,6"/>
                  <StackPanel Orientation="Horizontal" Margin="16,0,0,10" VerticalAlignment="Center">
                    <TextBlock Text="up to" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                    <TextBox Width="48" Margin="6,0,0,0"
                             Text="{Binding WgcPreviewMaxFps, UpdateSourceTrigger=LostFocus}"
                             HorizontalContentAlignment="Center" FontSize="12"/>
                    <TextBlock Text="FPS" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="4,0,0,0"/>
                    <TextBlock Text="(5-60; higher is smoother and lower-latency, at more GPU cost)"
                               VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="8,0,0,0"/>
                  </StackPanel>

                  <CheckBox Content="Hide all previews while EVE is not in focus"
                            IsChecked="{Binding HidePreviewsOnFocusLoss}"
                            ToolTip="Alt-tab to another app and previews hide; switch back to EVE and they return instantly."
                            Margin="0,0,0,6"/>
                  <StackPanel Orientation="Horizontal" Margin="16,0,0,10" VerticalAlignment="Center">
                    <TextBlock Text="after" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                    <TextBox Width="48" Margin="6,0,0,0"
                             Text="{Binding HidePreviewsOnFocusLossDelaySeconds, UpdateSourceTrigger=PropertyChanged}"
                             HorizontalContentAlignment="Center" FontSize="12"/>
                    <TextBlock Text="sec" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="4,0,0,0"/>
                    <TextBlock Text="(0 = instant; short delay prevents flicker when swapping seats)"
                               VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="6,0,0,0"/>
                  </StackPanel>

                  <StackPanel Orientation="Horizontal" Margin="0,0,0,6" VerticalAlignment="Center">
                    <TextBlock Text="Label position" VerticalAlignment="Center" Width="120" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                    <ComboBox Width="150" FontSize="12"
                              SelectedValue="{Binding CornerOverlayLabelAnchor}" SelectedValuePath="Tag"
                              ToolTip="Where the character name sits inside its preview tile.">
                      <ComboBoxItem Tag="TopLeft" Content="Top left"/>
                      <ComboBoxItem Tag="TopCenter" Content="Top center"/>
                      <ComboBoxItem Tag="TopRight" Content="Top right"/>
                      <ComboBoxItem Tag="MiddleLeft" Content="Middle left"/>
                      <ComboBoxItem Tag="Center" Content="Center"/>
                      <ComboBoxItem Tag="MiddleRight" Content="Middle right"/>
                      <ComboBoxItem Tag="BottomLeft" Content="Bottom left"/>
                      <ComboBoxItem Tag="BottomCenter" Content="Bottom center"/>
                      <ComboBoxItem Tag="BottomRight" Content="Bottom right"/>
                    </ComboBox>
                    <TextBlock Text="master" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="12,0,0,0"/>
                    <ComboBox Width="130" FontSize="12" Margin="6,0,0,0"
                              SelectedValue="{Binding CornerOverlayLabelAnchorMaster}" SelectedValuePath="Tag"
                              ToolTip="Where the label sits on the big center/master rect. That is the client you are actually looking at, so a label parked in the middle of it covers your ship - top usually reads better there while the small tiles stay centered.">
                      <ComboBoxItem Tag="TopLeft" Content="Top left"/>
                      <ComboBoxItem Tag="TopCenter" Content="Top center"/>
                      <ComboBoxItem Tag="TopRight" Content="Top right"/>
                      <ComboBoxItem Tag="MiddleLeft" Content="Middle left"/>
                      <ComboBoxItem Tag="Center" Content="Center"/>
                      <ComboBoxItem Tag="MiddleRight" Content="Middle right"/>
                      <ComboBoxItem Tag="BottomLeft" Content="Bottom left"/>
                      <ComboBoxItem Tag="BottomCenter" Content="Bottom center"/>
                      <ComboBoxItem Tag="BottomRight" Content="Bottom right"/>
                    </ComboBox>
                    <TextBlock Text="edge inset" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="12,0,0,0"/>
                    <TextBox Width="40" Margin="6,0,0,0"
                             Text="{Binding CornerOverlayLabelInset, UpdateSourceTrigger=PropertyChanged}"
                             HorizontalContentAlignment="Center" FontSize="12"
                             ToolTip="Gap in pixels between the label and the tile edge it hugs. Ignored on a centered axis."/>
                    <TextBlock Text="px" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="4,0,0,0"/>
                  </StackPanel>

                  <StackPanel Orientation="Horizontal" Margin="0,0,0,10" VerticalAlignment="Center">
                    <TextBlock Text="Zoom grows from" VerticalAlignment="Center" Width="120" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                    <ComboBox Width="130" FontSize="12"
                              SelectedValue="{Binding HoverZoomAnchor}" SelectedValuePath="Tag"
                              ToolTip="Which point a hover-zoomed tile expands from. Center grows evenly; an edge or corner pins that side so a tile against a screen edge grows inward instead of being clamped. Per-seat overrides live on each slot card in the Clients tab.">
                      <ComboBoxItem Tag="TopLeft" Content="Top left"/>
                      <ComboBoxItem Tag="TopCenter" Content="Top center"/>
                      <ComboBoxItem Tag="TopRight" Content="Top right"/>
                      <ComboBoxItem Tag="MiddleLeft" Content="Middle left"/>
                      <ComboBoxItem Tag="Center" Content="Center"/>
                      <ComboBoxItem Tag="MiddleRight" Content="Middle right"/>
                      <ComboBoxItem Tag="BottomLeft" Content="Bottom left"/>
                      <ComboBoxItem Tag="BottomCenter" Content="Bottom center"/>
                      <ComboBoxItem Tag="BottomRight" Content="Bottom right"/>
                    </ComboBox>
                  </StackPanel>

                  <StackPanel Orientation="Horizontal" Margin="0,0,0,10" VerticalAlignment="Center">
                    <TextBlock Text="Snap tiles to grid" VerticalAlignment="Center" Width="120" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                    <TextBox Width="48"
                             Text="{Binding CornerOverlaySnapGridPx, UpdateSourceTrigger=PropertyChanged}"
                             HorizontalContentAlignment="Center" FontSize="12"/>
                    <TextBlock Text="px" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="4,0,0,0"/>
                    <TextBlock Text="when dragging/resizing previews on the overlay (0 = free)"
                               VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="6,0,0,0"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,10" VerticalAlignment="Center">
                    <TextBlock Text="Auto-close overlay after" VerticalAlignment="Center" Width="120" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                    <TextBox Width="48"
                             Text="{Binding OfflineOverlayTimeoutSeconds, UpdateSourceTrigger=PropertyChanged}"
                             HorizontalContentAlignment="Center" FontSize="12"/>
                    <TextBlock Text="sec" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="4,0,0,0"/>
                    <TextBlock Text="of every seat offline (0 = never auto-close, default 60)" VerticalAlignment="Center"
                               Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="6,0,0,0"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Hide offline pill after" VerticalAlignment="Center" Width="120" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                    <TextBox Width="48"
                             Text="{Binding OfflinePillTimeoutSeconds, UpdateSourceTrigger=PropertyChanged}"
                             HorizontalContentAlignment="Center" FontSize="12"/>
                    <TextBlock Text="sec" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="4,0,0,0"/>
                    <TextBlock Text="offline (0 = hide immediately, -1 = never hide, default)" VerticalAlignment="Center"
                               Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="6,0,0,0"/>
                  </StackPanel>
                </StackPanel>
              </Border>
                  </StackPanel>
                  <!-- section 4: Preview non-EVE apps -->
                  <StackPanel Visibility="{Binding SelectedIndex, ElementName=PreviewsMenu, Converter={StaticResource IndexToVisibility}, ConverterParameter=4}">
                    <TextBlock Text="Preview non-EVE apps" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <TextBlock TextWrapping="Wrap" LineHeight="20" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,14">
                      Applications other than EVE that are allowed to appear as a preview.
                    </TextBlock>
              <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                      BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,4">
                <StackPanel>
                  <TextBlock TextWrapping="Wrap" LineHeight="20" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,8">
Apps listed here also show up as detected/assignable windows (Clients tab) so you can assign one to a slot and preview it alongside your EVE clients — e.g. Discord or a spreadsheet. Matched by process name (case-insensitive, partial match, no ".exe").
                  </TextBlock>
                  <ItemsControl ItemsSource="{Binding PreviewableApps}" Margin="0,0,0,6">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <DockPanel Margin="0,3">
                          <CheckBox DockPanel.Dock="Left" IsChecked="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}"
                                    VerticalAlignment="Center" Margin="0,0,8,0"/>
                          <Button DockPanel.Dock="Right" Content="Remove" Padding="7,3" FontSize="12" Margin="6,0,0,0"
                                  Command="{Binding DataContext.RemovePreviewableAppCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                  CommandParameter="{Binding}"/>
                          <TextBox Text="{Binding ProcessName, UpdateSourceTrigger=PropertyChanged}"
                                   Width="180" Padding="6,4" FontSize="12"
                                   ToolTip="Process name substring, case-insensitive (e.g. discord, excel)"/>
                        </DockPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Button Content="+ Add App" Command="{Binding AddPreviewableAppCommand}" Padding="8,4" FontSize="12" HorizontalAlignment="Left"/>
                </StackPanel>
              </Border>
                  </StackPanel>
                  <!-- section 5: Inactive client border -->
                  <StackPanel Visibility="{Binding SelectedIndex, ElementName=PreviewsMenu, Converter={StaticResource IndexToVisibility}, ConverterParameter=5}">
                    <TextBlock Text="Inactive client border" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <TextBlock TextWrapping="Wrap" LineHeight="20" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,14">
                      A plain outline drawn around the preview tiles of clients that aren't in focus.
                    </TextBlock>
              <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                      BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,14">
                <StackPanel>
                  <CheckBox Content="Outline inactive client previews"
                            IsChecked="{Binding InactivePreviewBorderEnabled}"
                            ToolTip="Draws a plain static outline around every preview tile whose EVE client is not the one you're currently using."
                            Margin="0,0,0,10"/>
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
                    <TextBlock Text="Thickness" VerticalAlignment="Center" Width="80" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                    <Slider Minimum="1" Maximum="12" Value="{Binding InactivePreviewBorderThickness}" Width="150" VerticalAlignment="Center"
                            IsSnapToTickEnabled="True" TickFrequency="1"/>
                    <TextBlock Text="{Binding InactivePreviewBorderThickness, StringFormat={}{0}px}" VerticalAlignment="Center" Margin="8,0,0,0" FontSize="12"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Color" VerticalAlignment="Center" Width="80" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                    <Border Width="24" Height="24" Margin="0,0,8,0" CornerRadius="4"
                            Background="{Binding InactivePreviewBorderBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                    <Button Content="Slate" Tag="#64748B" Click="InactiveBorderColorPreset_Click" Padding="6,3" FontSize="12" Margin="0,0,4,0"/>
                    <Button Content="Cyan"  Tag="#22D3EE" Click="InactiveBorderColorPreset_Click" Padding="6,3" FontSize="12" Margin="0,0,4,0"/>
                    <Button Content="Amber" Tag="#F59E0B" Click="InactiveBorderColorPreset_Click" Padding="6,3" FontSize="12" Margin="0,0,4,0"/>
                    <Button Content="Gray"  Tag="#9CA3AF" Click="InactiveBorderColorPreset_Click" Padding="6,3" FontSize="12"/>
                  </StackPanel>
                </StackPanel>
              </Border>
                  </StackPanel>
                </Grid>
              </ScrollViewer>
            </Grid>
  </Grid>
</UserControl>
