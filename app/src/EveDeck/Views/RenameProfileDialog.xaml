<Window x:Class="EveDeck.Views.RenameProfileDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rename Profile"
        WindowStartupLocation="CenterOwner"
        WindowStyle="ToolWindow"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Background="#12161D">
  <StackPanel Margin="18" MinWidth="320">
    <TextBlock Text="Rename Profile" Foreground="#EAF2FF" FontSize="15" FontWeight="SemiBold"/>
    <TextBlock Text="Give this layout a name for the profile list and hotkeys."
               Foreground="#8CA0B8" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,12"/>
    <TextBox x:Name="NameBox" Padding="6,4" FontSize="13"
             KeyDown="OnNameBoxKeyDown"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="Rename" Click="OnOk" Padding="12,5" Margin="0,0,8,0" FontWeight="SemiBold"/>
      <Button Content="Cancel" Click="OnCancel" Padding="12,5" IsCancel="True"/>
    </StackPanel>
  </StackPanel>
</Window>
