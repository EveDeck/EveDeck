<Window x:Class="EveDeck.Views.PassphraseDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Passphrase"
        WindowStartupLocation="CenterOwner"
        WindowStyle="ToolWindow"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Background="#12161D">
  <StackPanel Margin="18" MinWidth="360">
    <TextBlock x:Name="HeadingText" Foreground="#EAF2FF" FontSize="15" FontWeight="SemiBold"/>
    <TextBlock x:Name="BlurbText" Foreground="#8CA0B8" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,12"/>
    <PasswordBox x:Name="PassBox" Padding="6,4" FontSize="13" KeyDown="OnBoxKeyDown"/>
    <TextBlock x:Name="ConfirmLabel" Text="Confirm passphrase" Foreground="#8CA0B8" FontSize="12" Margin="0,10,0,4"/>
    <PasswordBox x:Name="ConfirmBox" Padding="6,4" FontSize="13" KeyDown="OnBoxKeyDown"/>
    <TextBlock x:Name="ErrorText" Foreground="#F87171" FontSize="12" TextWrapping="Wrap"
               Margin="0,10,0,0" Visibility="Collapsed"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button x:Name="OkButton" Click="OnOk" Padding="12,5" Margin="0,0,8,0" FontWeight="SemiBold"/>
      <Button Content="Cancel" Click="OnCancel" Padding="12,5" IsCancel="True"/>
    </StackPanel>
  </StackPanel>
</Window>
