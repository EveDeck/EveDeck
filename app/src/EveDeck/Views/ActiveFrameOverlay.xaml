<Window x:Class="EveDeck.Views.ActiveFrameOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Left="-10000" Top="-10000"
        Width="100" Height="100">
  <Grid>
    <!-- Plain full-perimeter outline: Solid/Dashed/Dotted styles, and the base layer under the
         brackets for the combined "Snapshot + Full Frame" style. Drawn first/underneath so the
         (slightly thicker) brackets read clearly on top of it at the corners. Never blurred. -->
    <Path x:Name="FrameOutline" Fill="Transparent" Visibility="Collapsed"/>
    <!-- Corner brackets: four L-shapes marking the client rect's corners instead of a full
         perimeter, optionally softened with a blur so they read as a glow. Geometry is built in
         ApplyFrame from the target size (the arms scale with the window). -->
    <Path x:Name="FrameBrackets" Fill="Transparent"
          StrokeThickness="8" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
      <Path.Effect>
        <BlurEffect x:Name="FrameBlur" Radius="6" KernelType="Gaussian"/>
      </Path.Effect>
    </Path>
  </Grid>
</Window>
